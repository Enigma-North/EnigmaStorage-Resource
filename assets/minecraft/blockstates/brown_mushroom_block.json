{
  "multipart": [
    { "when": { "north": "true", "east": "false", "south": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "minecraft:block/enigma/router", "y": 0 } },
    { "when": { "north": "false", "east": "true", "south": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "minecraft:block/enigma/router", "y": 90 } },
    { "when": { "north": "false", "east": "false", "south": "true", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "minecraft:block/enigma/router", "y": 180 } },
    { "when": { "north": "false", "east": "false", "south": "false", "west": "true", "up": "false", "down": "false" },
      "apply": { "model": "minecraft:block/enigma/router", "y": 270 } },

    { "when": { "up": "true" },    "apply": { "model": "minecraft:block/brown_mushroom_block" } },
    { "when": { "down": "true" },  "apply": { "model": "minecraft:block/brown_mushroom_block" } }
  ]
}
